# ==============================================================================
# MIMIC-IV Data Preparation & Ventilation RL Pipeline Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Google Drive Authentication & Mount Settings
# ------------------------------------------------------------------------------
GDRIVE_EMAIL=your_email@gmail.com
GDRIVE_PASSWORD=your_password_or_token

# Google Drive Mount Directory
# - On Google Colab: /content/drive
# - On macOS: /Users/<user>/Library/CloudStorage/GoogleDrive-<email>/My Drive
# - On Linux: /mnt/gdrive
GDRIVE_MOUNT_PATH=/Users/deepakyadav/Library/CloudStorage/GoogleDrive-yadav7deepak@gmail.com/My Drive

# ------------------------------------------------------------------------------
# 2. Input Dataset Paths (READ FULL DATA FROM GOOGLE DRIVE ONLY)
# ------------------------------------------------------------------------------
# Path to MIMIC-IV dataset on Google Drive
MIMIC_PATH=/Users/deepakyadav/Library/CloudStorage/GoogleDrive-yadav7deepak@gmail.com/My Drive/mimic-iv/physionet.org/files/mimiciv/3.0

# Optional path for pre-existing ventilation data on Google Drive (fallback for intermediate files)
GDRIVE_VENTILATION_DATA_PATH=/Users/deepakyadav/Library/CloudStorage/GoogleDrive-yadav7deepak@gmail.com/My Drive/mimic-iv/physionet.org/files/mimiciv/3.0/ventilation_data/patient_data

# ------------------------------------------------------------------------------
# 3. Output Data Directory (STORES OUTPUTS LOCALLY IN ./data)
# ------------------------------------------------------------------------------
LOCAL_DATA_DIR=./data

# ------------------------------------------------------------------------------
# 4. Generative AI / External API Keys
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
