, 'max': 10000},\n","        'BANDS': {'itemid': [51144], 'min': 0, 'max': 100},\n","        'BICARBONATE': {'itemid': [50882], 'min': 0, 'max': 10000},\n","        'BILIRUBIN': {'itemid': [50885], 'min': 0, 'max': 150},\n","        'CHLORIDE': {'itemid': [50806, 50902], 'min': 0, 'max': 10000},\n","        'CREATININE': {'itemid': [50912], 'min': 0, 'max': 150},\n","        'GLUCOSE': {'itemid': [50809, 50931], 'min': 0, 'max': 10000},\n","        'HEMATOCRIT': {'itemid': [50810, 51221], 'min': 0, 'max': 100},\n","        'HEMOGLOBIN': {'itemid': [50811, 51222], 'min': 0, 'max': 50},\n","        'LACTATE': {'itemid': [50813], 'min': 0, 'max': 50},\n","        'PLATELET': {'itemid': [51265], 'min': 0, 'max': 10000},\n","        'POTASSIUM': {'itemid': [50822, 50971], 'min': 0, 'max': 30},\n","        'PTT': {'itemid': [51275], 'min': 0, 'max': 150},\n","        'INR': {'itemid': [51237], 'min': 0, 'max': 50},\n","        'PT': {'itemid': [51274], 'min': 0, 'max': 150},\n","        'SODIUM': {'itemid': [50824, 50983], 'min': 0, 'max': 200},\n","        'BUN': {'itemid': [51006], 'min': 0, 'max': 300},\n","        'WBC': {'itemid': [51300, 51301], 'min': 0, 'max': 1000},\n","\n","        'MAGNESIUM': {'itemid': [50960], 'min': 0, 'max': float('inf')},\n","        'CARBONDIOXIDE': {'itemid': [50804], 'min': 0, 'max': float('inf')},\n","        'BASE_EXCESS': {'itemid': [50802], 'min': -10, 'max': 10},\n","        'CALCIUM': {'itemid': [50893], 'min': 0, 'max': float('inf')},\n","        'PH': {'itemid': [50820], 'min': 7, 'max': 8},\n","        'PAO2': {'itemid': [50821], 'min': 70, 'max': 110},\n","        'PACO2': {'itemid': [50818], 'min': 22, 'max': 58}\n","    }\n","\n","    # Get all item IDs\n","    all_itemids = []\n","    for lab in lab_items.values():\n","        all_itemids.extend(lab['itemid'])\n","\n","    # Load labevents table with only the needed columns and item IDs\n","    labevents = pd.read_csv(f\"{mimic_path}/hosp/labevents.csv.gz\",\n","                            usecols=['subject_id', 'hadm_id', 'itemid', 'charttime', 'valuenum'],\n","                            parse_dates=['charttime'])\n","    # Filter for relevant item IDs\n","    labevents = labevents[labevents['itemid'].isin(all_itemids)]\n","\n","    # Load icustays table\n","    icustays = pd.read_csv(f\"{mimic_path}/icu/icustays.csv.gz\",\n","                           usecols=['subject_id', 'hadm_id', 'stay_id', 'intime', 'outtime'],\n","                           parse_dates=['intime', 'outtime'])\n","\n","    # Join labevents with icustays to get stay_id\n","    labevents_with_icustay = pd.merge(\n","        labevents,\n","        icustays,\n","        on=['subject_id', 'hadm_id'],\n","        how='inner'\n","    )\n","\n","    # Filter for lab events that occurred during ICU stay (with 6 hour buffer before and 1 day after)\n","    labevents_with_icustay = labevents_with_icustay[\n","        (labevents_with_icustay['charttime'] >= labevents_with_icustay['intime'] - timedelta(hours=6)) &\n","        (labevents_with_icustay['charttime'] <= labevents_with_icustay['intime'] + timedelta(days=1))\n","    ]\n","\n","    # Create a new dataframe to store the processed lab values\n","    lab_values = pd.DataFrame()\n","    lab_values['subject_id'] = labevents_with_icustay['subject_id']\n","    lab_values['hadm_id'] = labevents_with_icustay['hadm_id']\n","    lab_values['stay_id'] = labevents_with_icustay['stay_id']\n","    lab_values['charttime'] = labevents_with_icustay['charttime']\n","\n","    # Process each lab item\n","    for lab_name, lab_info in lab_items.items():\n","        # Create a mask for this lab item\n","        mask = labevents_with_icustay['itemid'].isin(lab_info['itemid'])\n","\n","        # Apply value range constraints\n","        valid_values = (\n","            (labevents_with_icustay['valuenum'] >= lab_info['min']) &\n","            (labevents_with_icustay['valuenum'] <= lab_info['max'])\n","        )\n","        combined_mask = mask & valid_values\n","\n","        # Create a temporary series with the lab values\n","        temp_series = pd.Series(index=labevents_with_icustay.index, dtype='float64')\n","        temp_series.loc[combined_mask] = labevents_with_icustay.loc[combined_mask, 'valuenum']\n","\n","        # Add to the lab_values dataframe\n","        lab_values[lab_name] = temp_series\n","\n","    # Group by patient and time to get one row per observation\n","    lab_values_grouped = lab_values.groupby(['subject_id', 'hadm_id', 'stay_id', 'charttime']).agg(\n","        {col: 'mean' for col in lab_values.columns if col not in ['subject_id', 'hadm_id', 'stay_id', 'charttime']}\n","    ).reset_index()\n","\n","    # Save to CSV\n","    lab_values_grouped.to_csv(f\"{output_path}/lab_values.csv\", index=False)\n","    print(f\"Lab values saved to {output_path}/lab_values.csv\")\n","\n","    return lab_values_grouped\n"],"metadata":{"id":"TOFtjzwyuiHa","executionInfo":{"status":"ok","timestamp":1758433029708,"user_tz":-330,"elapsed":81,"user":{"displayName":"DEEPAK YADAV","userId":"01185345729573315633"}}},"execution_count":6,"outputs":[]},{"cell_type":"code","source":["lab_values = create_lab_values(mimic_path, output_path)\n","print(lab_values.head())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"dxHsoJRmuiRB","executionInfo":{"status":"ok","timestamp":1758433226066,"user_tz":-330,"elapsed":192993,"user":{"displayName":"DEEPAK YADAV","userId":"01185345729573315633"}},"outputId":"59c5c651-de61-4d06-9280-c558b921e2bc"},"execution_count":7,"outputs":[{"output_type":"stream","name":"stdout","text":["Creating lab values dataframe...\n","Loading labevents and icustays tables...\n","Lab values saved to /content/drive/My Drive/mimic-iv/physionet.org/files/mimiciv/3.0/ventilation_data/patient_data/lab_values.csv\n","   subject_id     hadm_id   stay_id           charttime  ALBUMIN  ANIONGAP  \\\n","0    10000032  29079034.0  39553978 2180-07-23 21:45:00      NaN      14.0   