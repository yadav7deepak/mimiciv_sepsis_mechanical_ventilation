ath (str): Path to MIMIC-III data\n","    output_path (str): Path to save the output dataframe\n","\n","    Returns:\n","    pd.DataFrame: Urine output dataframe\n","    \"\"\"\n","    print(\"Creating urine output dataframe...\")\n","\n","    # Define urine output item IDs\n","    urine_itemids = [\n","        # CareVue\n","        40055, 43175, 40069, 40094, 40715, 40473, 40085, 40057, 40056, 40405, 40428, 40086, 40096, 40651,\n","        # MetaVision\n","        225659, 226560, 226561, 226584, 226563, 226564, 226565, 226567, 226557, 226558, 227488, 227489\n","    ]\n","\n","    chunk_size = 1000000  # Adjust based on available memory\n","    chunks = []\n","\n","    for chunk in pd.read_csv(f\"{mimic_path}/icu/outputevents.csv.gz\",\n","                             usecols=['subject_id', 'hadm_id', 'stay_id', 'itemid', 'charttime', 'value'],\n","                             parse_dates=['charttime'],\n","                             chunksize=chunk_size):\n","        filtered_chunk = chunk[\n","            (chunk['itemid'].isin(urine_itemids))\n","        ]\n","        if not filtered_chunk.empty:\n","            chunks.append(filtered_chunk)\n","\n","    if not chunks:\n","        print(\"No urine output data found.\")\n","        return None\n","\n","    outputevents = pd.concat(chunks, ignore_index=True)\n","\n","    # Process GU irrigant volume (item 227488) as negative volume\n","    outputevents['adjusted_value'] = outputevents.apply(\n","        lambda row: -1 * row['value'] if row['itemid'] == 227488 and row['value'] > 0 else row['value'], axis=1\n","    )\n","\n","    # Group by patient and time to get total urine output\n","    urine_output = outputevents.groupby(\n","        ['subject_id', 'hadm_id', 'stay_id', 'charttime']\n","    )['adjusted_value'].sum().reset_index()\n","    urine_output.rename(columns={'adjusted_value': 'urineOutput'}, inplace=True)\n","\n","    # Save to CSV\n","    urine_output.to_csv(f\"{output_path}/urine_output.csv\", index=False)\n","    print(f\"Urine output data saved to {output_path}/urine_output.csv\")\n","\n","    return urine_output"],"metadata":{"id":"QqiodAn3wMSc","executionInfo":{"status":"ok","timestamp":1758433777348,"user_tz":-330,"elapsed":73,"user":{"displayName":"DEEPAK YADAV","userId":"01185345729573315633"}}},"execution_count":10,"outputs":[]},{"cell_type":"code","source":["urine_output = create_urine_output(mimic_path, output_path)\n","print(urine_output.head())"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"2dsrEdO6wO_e","executionInfo":{"status":"ok","timestamp":1758433792438,"user_tz":-330,"elapsed":11324,"user":{"displayName":"DEEPAK YADAV","userId":"01185345729573315633"}},"outputId":"b6d1ae89-3d65-4b2e-d467-d2707eeb36b5"},"execution_count":11,"outputs":[{"output_type":"stream","name":"stdout","text":["Creating urine output dataframe...\n","Urine output data saved to /content/drive/My Drive/mimic-iv/physionet.org/files/mimiciv/3.0/ventilation_data/patient_data/urine_output.csv\n","   subject_id   hadm_id   stay_id           charttime  urineOutput\n","0    10000032  29079034  39553978 2180-07-23 15:00:00        175.0\n","1    10001217  24597018  37067082 2157-11-20 19:00:00        100.0\n","2    10001217  24597018  37067082 2157-11-20 22:00:00        120.0\n","3    10001217  24597018  37067082 2157-11-21 00:42:00        300.0\n","4    10001217  24597018  37067082 2157-11-21 04:00:00        600.0\n"]}]}]}