cu/icustays.csv.gz\",\n","                           usecols=['subject_id', 'hadm_id', 'stay_id'],\n","                           dtype={'stay_id': int})\n","\n","    # Process input events for CareVue patients\n","    inputevents_cv = pd.read_csv(f\"{mimic_path}/icu/inputevents.csv.gz\",\n","                                usecols=['stay_id', 'storetime', 'amount', 'amountuom'],\n","                                parse_dates=['storetime'])\n","    inputevents_cv = inputevents_cv[inputevents_cv['amountuom'].isin(['cc', 'L', 'ml', 'uL'])]\n","\n","    def convert_to_ml(row):\n","        if row['amountuom'] == 'ml':\n","            return row['amount']\n","        elif row['amountuom'] == 'L':\n","            return row['amount'] * 1000\n","        elif row['amountuom'] == 'uL':\n","            return row['amount'] / 1000\n","        return None\n","\n","    inputevents_cv['amount_ml'] = inputevents_cv.apply(convert_to_ml, axis=1)\n","    cv_input = inputevents_cv.groupby(['stay_id', 'storetime'])['amount'].sum().reset_index()\n","    cv_input.rename(columns={'amount': 'in_amount'}, inplace=True)\n","    cv_input = pd.merge(cv_input, icustays, on='stay_id', how='inner')\n","\n","    # # Process input events for MetaVision patients\n","    # inputevents_mv = pd.read_csv(f\"{mimic_path}/inputevents_mv.csv.gz\",\n","    #                             usecols=['icustay_id', 'starttime', 'amount', 'amountuom'],\n","    #                             parse_dates=['starttime'])\n","    # inputevents_mv = inputevents_mv[inputevents_mv['amountuom'].isin(['L', 'ml', 'uL'])]\n","\n","    # def convert_to_ml(row):\n","    #     if row['amountuom'] == 'ml':\n","    #         return row['amount']\n","    #     elif row['amountuom'] == 'L':\n","    #         return row['amount'] * 1000\n","    #     elif row['amountuom'] == 'uL':\n","    #         return row['amount'] / 1000\n","    #     return None\n","\n","    # inputevents_mv['amount_ml'] = inputevents_mv.apply(convert_to_ml, axis=1)\n","    # mv_input = inputevents_mv.groupby(['icustay_id', 'starttime'])['amount_ml'].sum().reset_index()\n","    # mv_input.rename(columns={'starttime': 'charttime', 'amount_ml': 'in_amount'}, inplace=True)\n","    # mv_input = pd.merge(mv_input, icustays, on='icustay_id', how='inner')\n","\n","    # Process output events\n","    outputevents = pd.read_csv(f\"{mimic_path}/icu/outputevents.csv.gz\",\n","                               usecols=['stay_id', 'storetime', 'value', 'valueuom'],\n","                               parse_dates=['storetime'])\n","    outputevents = outputevents[outputevents['valueuom'].isin(['ml', 'mL'])]\n","\n","    output = outputevents.groupby(['stay_id', 'storetime'])['value'].sum().reset_index()\n","    output.rename(columns={'value': 'out_amount'}, inplace=True)\n","    output = pd.merge(output, icustays, on='stay_id', how='inner')\n","\n","    # Combine all input and output events\n","    # all_input = pd.concat([cv_input, mv_input], ignore_index=True)\n","    all_fluid = pd.merge(cv_input, output, on=['stay_id', 'storetime'], how='outer')\n","\n","    # Sort by stay_id and charttime\n","    all_fluid = all_fluid.sort_values(['stay_id', 'storetime'])\n","\n","    # Calculate cumulative amounts\n","    all_fluid['in_cum_amt'] = all_fluid.groupby('stay_id')['in_amount'].transform(lambda x: x.fillna(0).cumsum())\n","    all_fluid['out_cum_amt'] = all_fluid.groupby('stay_id')['out_amount'].transform(lambda x: x.fillna(0).cumsum())\n","\n","    # Calculate cumulative fluid balance\n","    all_fluid['cum_fluid_balance'] = all_fluid['in_cum_amt'].fillna(0) - all_fluid['out_cum_amt'].fillna(0)\n","\n","    # Save to CSV\n","    all_fluid.to_csv(f\"{output_path}/cum_fluid.csv\", index=False)\n","    print(f\"Cumulative fluid balance saved to {output_path}/cum_fluid.csv\")\n","\n","    return all_fluid\n"],"metadata":{"id":"CIEJZSxYvFHg","executionInfo":{"status":"ok","timestamp":1758434707842,"user_tz":-330,"elapsed":35,"user":{"displayNam